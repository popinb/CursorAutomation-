# LLM Evaluation Framework Environment Variables
# Copy this file to .env and customize for your environment

# Workspace root directory (defaults to current directory)
WORKSPACE_ROOT=/path/to/your/workspace

# Directory overrides (optional - will override config.json values)
LLM_EVAL_DATA_DIR=/path/to/data
LLM_EVAL_RESULTS_DIR=/path/to/results
LLM_EVAL_LOGS_DIR=/path/to/logs
LLM_EVAL_CONFIGS_DIR=/path/to/configs
LLM_EVAL_METRICS_DIR=/path/to/metrics
LLM_EVAL_GROUND_TRUTH_DIR=/path/to/ground_truth
LLM_EVAL_REPORTS_DIR=/path/to/reports
LLM_EVAL_ARTIFACTS_DIR=/path/to/artifacts
LLM_EVAL_MLFLOW_DIR=/path/to/mlflow
LLM_EVAL_TEMP_DIR=/tmp/llm_eval

# Databricks-specific paths (when running in Databricks)
# WORKSPACE_ROOT=/Workspace/Users/your_username@company.com
# LLM_EVAL_RESULTS_DIR=/dbfs/FileStore/llm_evaluation/results
# LLM_EVAL_ARTIFACTS_DIR=/dbfs/FileStore/llm_evaluation/artifacts

# Cloud storage examples (AWS S3, Azure Blob, GCS)
# LLM_EVAL_DATA_DIR=s3://my-bucket/llm-evaluation/data
# LLM_EVAL_RESULTS_DIR=s3://my-bucket/llm-evaluation/results

# User information (optional - used for user-specific paths)
USER=your_username