import json
from typing import Dict, Any, List

import pandas as pd
from docx import Document
from striprtf.striprtf import rtf_to_text

from zillow_judge_evaluator import ZillowJudgeEvaluator

# Paths in DBFS (adjust if needed)
DBFS_DIR = "/dbfs/FileStore/zillow"
DOCX_GOLDEN = os.path.join(DBFS_DIR, "godenresponsealpha.docx")
RTF_PROFILE = os.path.join(DBFS_DIR, "buyabilityprofile.rtf")
DOCX_FAIR = os.path.join(DBFS_DIR, "ZIllow_Fair_Housing_Classifier.docx")

ASSETS_DIR = "/workspace/assets"
FALLBACK_GOLDEN_JSON = os.path.join(ASSETS_DIR, "golden_responses.json")
FALLBACK_PROFILES_JSON = os.path.join(ASSETS_DIR, "buyability_profiles.json")
FALLBACK_FAIR_JSON = os.path.join(ASSETS_DIR, "fair_housing_guide.json")


def load_golden_from_docx(path: str) -> Dict[str, Any]:
    if not os.path.exists(path):
        with open(FALLBACK_GOLDEN_JSON) as f:
            return json.load(f)
    doc = Document(path)
    questions: Dict[str, Dict[str, Any]] = {}
    q_idx = 0
    current_q = None
    buffer: List[str] = []
    for p in doc.paragraphs:
        text = p.text.strip()
        if not text:
            continue
        if text.endswith("?") and len(text) < 200:
            if current_q and buffer:
                q_idx += 1
                questions[str(q_idx)] = {
                    "question": current_q,
                    "response_template": "\n".join(buffer),
                    "variables": []
                }
                buffer = []
            current_q = text
        else:
            buffer.append(text)
    if current_q and buffer:
        q_idx += 1
        questions[str(q_idx)] = {
            "question": current_q,
            "response_template": "\n".join(buffer),
            "variables": []
        }
    return {"questions": questions}


def load_profiles_from_rtf(path: str) -> List[Dict[str, Any]]:
    if not os.path.exists(path):
        with open(FALLBACK_PROFILES_JSON) as f:
            return json.load(f)
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        rtf_text = f.read()
    text = rtf_to_text(rtf_text)
    profiles: List[Dict[str, Any]] = []
    for line in text.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        name, rest = line.split(":", 1)
        row: Dict[str, Any] = {"profile_id": name.strip()}
        for part in rest.split(","):
            kv = part.strip().split("=", 1)
            if len(kv) != 2:
                continue
            k, v = kv[0].strip().lower(), kv[1].strip()
            if k in ("income", "annual_income"):
                row["annual_income"] = int(str(v).replace(",", "").replace("$", ""))
            elif k in ("debts", "monthly_debts"):
                row["monthly_debts"] = int(str(v).replace(",", "").replace("$", ""))
            elif k in ("down", "down_payment"):
                row["down_payment"] = int(str(v).replace(",", "").replace("$", ""))
            elif k in ("credit", "credit_score", "credit_score_range"):
                row["credit_score"] = v
            elif k in ("target", "preferred_monthly_payment"):
                row["preferred_monthly_payment"] = int(str(v).replace(",", "").replace("$", ""))
            elif k in ("max", "comfortable_max_monthly_payment"):
                row["comfortable_max_monthly_payment"] = int(str(v).replace(",", "").replace("$", ""))
        profiles.append(row)
    return profiles


def load_fair_from_docx(path: str) -> Dict[str, Any]:
    if not os.path.exists(path):
        with open(FALLBACK_FAIR_JSON) as f:
            return json.load(f)
    doc = Document(path)
    bullets: List[str] = []
    for p in doc.paragraphs:
        t = p.text.strip()
        if t:
            bullets.append(t)
    return {"doc": bullets}


def pick_profile_row(profiles: List[Dict[str, Any]], user_profile: Dict[str, Any]) -> Dict[str, Any]:
    if not profiles:
        return user_profile
    def distance(p):
        d = 0
        for key in ("annual_income", "monthly_debts", "down_payment"):
            if key in p and key in user_profile:
                d += abs(int(p[key]) - int(user_profile[key]))
        return d
    return sorted(profiles, key=distance)[0]pip install -q -r /workspace/requirements.txt## Databricks LLM-as-a-Judge (Zillow)

This notebook implements a deterministic evaluator ("LLM as a judge") for Zillow-style buyability responses in Databricks. It:
- Loads ground-truths from `godenresponsealpha.docx`, `buyabilityprofile.rtf`, and `ZIllow_Fair_Housing_Classifier.docx` (or falls back to JSON assets).
- Uses `ZillowJudgeEvaluator` to score 12 metrics with ≥150-word narrative justifications per metric.
- Computes the required “Alpha evaluation” (0–100), weighting metrics equally while omitting `Structured Presentation` and `Completeness`.
- Optionally demonstrates evaluation of model outputs via OpenAI Responses API.

Prerequisites:
- Upload the three ground-truth files to DBFS (e.g., `/dbfs/FileStore/zillow/`).
- Configure your OpenAI API key as a Databricks secret or environment variable if using the Responses API.