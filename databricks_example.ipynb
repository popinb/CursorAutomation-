# 1. Show schema
print("DataFrame Schema:")
df.printSchema()

# 2. Basic statistics
print("\nBasic Statistics:")
df.describe(['price', 'quantity', 'total_sales']).show()

# 3. Filter operations
print("\nHigh-value sales (>1000):")
high_value_sales = df.filter(col("total_sales") > 1000)
high_value_sales.show(10)

# 4. Group by operations
print("\nSales by Department:")
dept_sales = df.groupBy("department").agg(
    sum("total_sales").alias("total_revenue"),
    avg("total_sales").alias("avg_sale_amount"),
    count("*").alias("transaction_count")
).orderBy(desc("total_revenue"))
dept_sales.show()

print("\nSales by Region:")
region_sales = df.groupBy("region").agg(
    sum("total_sales").alias("total_revenue"),
    count("*").alias("transaction_count")
).orderBy(desc("total_revenue"))
region_sales.show()## 2. DataFrame Operations

Let's perform some common DataFrame operations like filtering, grouping, and aggregations.# Create sample data
from datetime import datetime, timedelta
import random

# Sample data for a sales dataset
sample_data = []
departments = ['Electronics', 'Clothing', 'Home & Garden', 'Sports', 'Books']
regions = ['North', 'South', 'East', 'West', 'Central']

for i in range(1000):
    sample_data.append((
        i + 1,  # id
        f"Product_{i % 100}",  # product_name
        random.choice(departments),  # department
        random.choice(regions),  # region
        round(random.uniform(10, 500), 2),  # price
        random.randint(1, 10),  # quantity
        datetime.now() - timedelta(days=random.randint(0, 365))  # sale_date
    ))

# Define schema
schema = StructType([
    StructField("id", IntegerType(), True),
    StructField("product_name", StringType(), True),
    StructField("department", StringType(), True),
    StructField("region", StringType(), True),
    StructField("price", DoubleType(), True),
    StructField("quantity", IntegerType(), True),
    StructField("sale_date", TimestampType(), True)
])

# Create DataFrame
df = spark.createDataFrame(sample_data, schema)

# Add calculated column for total_sales
df = df.withColumn("total_sales", col("price") * col("quantity"))

print(f"Created DataFrame with {df.count()} rows and {len(df.columns)} columns")
df.show(5)## 1. Creating Sample Data

