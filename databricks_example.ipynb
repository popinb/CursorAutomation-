Databricks provides easy ways to read and write data from various sources including DBFS, cloud storage, and databases.# Import MLlib libraries
from pyspark.ml.feature import StringIndexer, VectorAssembler, StandardScaler
from pyspark.ml.regression import LinearRegression
from pyspark.ml.evaluation import RegressionEvaluator
from pyspark.ml import Pipeline

# Prepare data for machine learning
print("Preparing data for machine learning...")

# Create string indexers for categorical variables
dept_indexer = StringIndexer(inputCol="department", outputCol="department_idx")
region_indexer = StringIndexer(inputCol="region", outputCol="region_idx")

# Create feature vector
feature_cols = ["department_idx", "region_idx", "price", "quantity"]
assembler = VectorAssembler(inputCols=feature_cols, outputCol="features")

# Create and scale features
scaler = StandardScaler(inputCol="features", outputCol="scaled_features")

# Create linear regression model
lr = LinearRegression(featuresCol="scaled_features", labelCol="total_sales")

# Create pipeline
pipeline = Pipeline(stages=[dept_indexer, region_indexer, assembler, scaler, lr])

# Split data into training and test sets
train_data, test_data = df.randomSplit([0.8, 0.2], seed=42)

print(f"Training data: {train_data.count()} rows")
print(f"Test data: {test_data.count()} rows")

# Train the model
print("Training the model...")
model = pipeline.fit(train_data)

# Make predictions
print("Making predictions...")
predictions = model.transform(test_data)

# Show some predictions
print("Sample predictions:")
predictions.select("total_sales", "prediction", "department", "region", "price", "quantity").show(10)

# Evaluate the model
evaluator = RegressionEvaluator(labelCol="total_sales", predictionCol="prediction")
rmse = evaluator.evaluate(predictions, {evaluator.metricName: "rmse"})
r2 = evaluator.evaluate(predictions, {evaluator.metricName: "r2"})

print(f"Root Mean Square Error (RMSE): {rmse:.2f}")
print(f"R-squared (R2): {r2:.4f}")

# Feature importance (coefficients)
lr_model = model.stages[-1]
print(f"Model coefficients: {lr_model.coefficients}")
print(f"Model intercept: {lr_model.intercept}")## 5. Machine Learning with MLlib

