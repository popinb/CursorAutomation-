# 1. Caching frequently used DataFrames
print("1. Caching DataFrames:")
df.cache()  # Cache the DataFrame in memory
print("   ✓ DataFrame cached for faster subsequent operations")

# 2. Partitioning data
print("\n2. Data Partitioning:")
print(f"   Current partitions: {df.rdd.getNumPartitions()}")

# Repartition based on data size (rule of thumb: 128MB per partition)
optimal_partitions = max(1, df.count() // 1000)  # Rough estimate
df_repartitioned = df.repartition(optimal_partitions)
print(f"   Repartitioned to: {df_repartitioned.rdd.getNumPartitions()} partitions")

# 3. Using broadcast variables for small lookup tables
print("\n3. Broadcast Joins:")
# Create a small lookup table
department_info = spark.createDataFrame([
    ("Electronics", "Tech"),
    ("Clothing", "Fashion"),
    ("Home & Garden", "Lifestyle"),
    ("Sports", "Recreation"),
    ("Books", "Education")
], ["department", "category"])

# Broadcast the small table for efficient joins
from pyspark.sql.functions import broadcast
result = df.join(broadcast(department_info), "department")
print("   ✓ Used broadcast join for small lookup table")

# 4. Column pruning - select only needed columns
