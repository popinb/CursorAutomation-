Databricks supports multiple visualization libraries. Let's create some charts to visualize our data.# Create a temporary view for SQL queries
df.createOrReplaceTempView("sales_data")

# SQL query examples
print("Top 10 products by total sales:")
top_products = spark.sql("""
    SELECT 
        product_name,
        SUM(total_sales) as total_revenue,
        COUNT(*) as sales_count,
        AVG(total_sales) as avg_sale_amount
    FROM sales_data 
    GROUP BY product_name 
    ORDER BY total_revenue DESC 
    LIMIT 10
""")
top_products.show()

print("\nMonthly sales trend:")
monthly_sales = spark.sql("""
    SELECT 
        YEAR(sale_date) as year,
        MONTH(sale_date) as month,
        SUM(total_sales) as monthly_revenue,
        COUNT(*) as transaction_count
    FROM sales_data 
    GROUP BY YEAR(sale_date), MONTH(sale_date)
    ORDER BY year, month
""")
monthly_sales.show()

print("\nDepartment performance with ranking:")
dept_ranking = spark.sql("""
    SELECT 
        department,
        SUM(total_sales) as total_revenue,
        AVG(total_sales) as avg_sale,
        RANK() OVER (ORDER BY SUM(total_sales) DESC) as revenue_rank
    FROM sales_data 
    GROUP BY department
    ORDER BY revenue_rank
""")
dept_ranking.show()## 3. SQL Queries

