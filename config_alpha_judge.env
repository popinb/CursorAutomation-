# Alpha Judge Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default settings
ALPHA_JUDGE_MODEL=o3
ALPHA_CANDIDATE_MODEL=gpt-4o-mini
ALPHA_RUN_NAME=alpha-judge-run
ALPHA_SAVE_DIR=./alpha_judge_runs
ALPHA_GT_DIR=./ground_truths