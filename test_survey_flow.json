{
  "survey_flow_test": {
    "description": "Test Survey Flow configuration and embedded data logic",
    "test_scenarios": [
      {
        "scenario": "Group 1 Assignment",
        "embedded_data_values": {
          "participant_id": "TEST001",
          "current_trial": "1",
          "trial_1_prompt_id": "1",
          "trial_1_modality": "nonstream",
          "trial_1_latency_ms": "500",
          "trial_1_tft_ms": "300",
          "trial_2_prompt_id": "2",
          "trial_2_modality": "nonstream", 
          "trial_2_latency_ms": "2000",
          "trial_2_tft_ms": "300",
          "trial_3_prompt_id": "3",
          "trial_3_modality": "nonstream",
          "trial_3_latency_ms": "6000",
          "trial_3_tft_ms": "300",
          "trial_4_prompt_id": "4",
          "trial_4_modality": "stream",
          "trial_4_latency_ms": "2000",
          "trial_4_tft_ms": "300",
          "trial_5_prompt_id": "5",
          "trial_5_modality": "stream",
          "trial_5_latency_ms": "6000",
          "trial_5_tft_ms": "300"
        },
        "expected_behavior": {
          "trial_1": {
            "prompt": "Define 'compound interest' in one sentence.",
            "timing": "Non-streaming, 500ms delay",
            "response_appears": "All at once after 0.5 seconds"
          },
          "trial_4": {
            "prompt": "Summarize this blurb in one sentence: 'Machine learning algorithms require large datasets to train effectively. However, collecting quality data can be expensive and time-consuming. Synthetic data generation offers a promising solution to this challenge.'",
            "timing": "Streaming, 2000ms total, 300ms to first token",
            "response_appears": "Gradually over 1.7 seconds after 0.3s delay"
          }
        }
      }
    ],
    "data_validation_checks": [
      {
        "check": "Embedded data field presence",
        "fields_required": [
          "participant_id",
          "current_trial",
          "trial_1_prompt_id",
          "trial_1_modality",
          "trial_1_latency_ms",
          "trial_1_tft_ms"
        ],
        "validation": "All fields must be present and populated"
      },
      {
        "check": "Data type validation",
        "validations": [
          {"field": "trial_X_prompt_id", "type": "string", "values": ["1", "2", "3", "4", "5"]},
          {"field": "trial_X_modality", "type": "string", "values": ["stream", "nonstream"]},
          {"field": "trial_X_latency_ms", "type": "integer", "values": [500, 2000, 6000]},
          {"field": "trial_X_tft_ms", "type": "integer", "values": [300]}
        ]
      },
      {
        "check": "JavaScript variable substitution",
        "test_cases": [
          {
            "embedded_data": "trial_1_prompt_id = '1'",
            "javascript_reference": "${e://Field/trial_1_prompt_id}",
            "expected_result": "1"
          },
          {
            "embedded_data": "current_trial = '3'",
            "javascript_reference": "${e://Field/current_trial}",
            "expected_result": "3"
          }
        ]
      }
    ],
    "qualtrics_implementation_notes": [
      "Survey Flow order is critical - embedded data must be set before blocks",
      "Randomizer must assign all trial variables before first trial block",
      "Each trial block needs current_trial embedded data updated",
      "JavaScript uses ${e://Field/variable_name} syntax for embedded data",
      "Timing questions should be added to capture page exposure time",
      "Force Response should be enabled on all matrix questions"
    ]
  },
